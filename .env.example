# ==== 复制本文件为 .env，把 key 填进去 ====

# DeepSeek（AI 加工：书面化 / 总结 / 翻译）—— 现在就需要
# 申请地址：https://platform.deepseek.com/  控制台里创建 API key
DEEPSEEK_API_KEY=

# 可选：模型与分块参数（不填用默认值，够用）
# deepseek-v4-flash(便宜快，默认) 或 deepseek-v4-pro(更强更贵)。两者都是 384K 输出帽。
DEEPSEEK_MODEL=deepseek-v4-flash
# 普通模式每块字数（V4 输出帽大，可放大以减少拼接缝）
CHUNK_CHARS=6000
# 高保真模式每块字数（更小=更不容易漏内容）
HIFI_CHUNK_CHARS=3000

# 阿里云 DashScope（音频转写）—— 之后想用"音频链接转逐字稿"再填
# 申请地址：https://dashscope.console.aliyun.com/  开通后创建 API-KEY
DASHSCOPE_API_KEY=
